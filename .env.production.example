# ==============================================================================
# FORMAT .env SIAP DEPLOY (PRODUCTION) - TA-SIJARENG
# Salin isi file ini ke .env di server production, lalu jalankan:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
# ==============================================================================

APP_NAME="TA-SIJARENG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Gunakan 'daily' di production agar log terpecah per hari & tidak menumpuk
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database Production (isi sesuai kredensial server/hosting)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_db_production
DB_USERNAME=user_db_production
DB_PASSWORD=password_db_yang_kuat

# Session Production (aktifkan SESSION_SECURE_COOKIE=true jika sudah HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=sijareng_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Konfigurasi Email SMTP Production
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.provider-anda.com
MAIL_PORT=587
MAIL_USERNAME=email@domain-anda.com
MAIL_PASSWORD=password_atau_app_password
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# URL Python Face Recognition Service (HTTPS atau reverse proxy Nginx di VPS, misal https://domain-anda.com/face-api)
PYTHON_FACE_SERVICE_URL=https://domain-anda.com/face-api

